DATABASE_URL="file:./prisma/dev.db"
# Switch to supabase only after running and verifying the data import.
DATABASE_PROVIDER="sqlite"
SUPABASE_DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
PORT=5000
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"
AUTH_COOKIE_DAYS=7
ALLOW_PUBLIC_REGISTRATION="true"
# Optional comma-separated hosting origins, e.g. https://sports.example.com
ALLOWED_ORIGINS=""
# Authentication security (keep secrets out of Git)
# Local: http://localhost:5000. Vercel Production: https://school-sport-hub.vercel.app
APP_BASE_URL="http://localhost:5000"
# Exactly 64 hexadecimal characters (32 random bytes). Keep stable and back it up securely.
AUTH_ENCRYPTION_KEY=""
# Choose brevo or resend. Only set the credentials for the selected provider.
AUTH_EMAIL_PROVIDER="resend"
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
# Resend sending-only key and an address on a verified domain you own.
RESEND_API_KEY=""
EMAIL_FROM="Sports Hub <noreply@your-verified-domain.example>"

# Optional until email delivery has been configured and tested.
REQUIRE_EMAIL_VERIFICATION="false"
# Exact student mailbox domain (without @). Enable only after testing email delivery.
ANCHOR_STUDENT_EMAIL_DOMAIN=""
# Optional international headlines (server only); see NEWS-SETUP.md.
THENEWSAPI_API_KEY=
# Random secret for the daily archive cleanup endpoint. Keep private.
CRON_SECRET=

# Requires verification for all sign-ins and starts the scheduled Anchor email rollout.
REQUIRE_VERIFIED_SIGN_IN="false"

# Web Push: stable VAPID keys generated once with npx web-push generate-vapid-keys.
MATCH_PUSH_PUBLIC_KEY=""
MATCH_PUSH_PRIVATE_KEY=""
MATCH_PUSH_SUBJECT=""
