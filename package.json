{
  "name": "school-sport-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "School Sports Hub static frontend and Express API",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/check.mjs",
    "start": "node dist/server/src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "admin:create": "tsx server/src/scripts/create-admin.ts",
    "db:import-static-sports": "tsx server/src/scripts/import-static-sports.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "prisma": "^7.10.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
