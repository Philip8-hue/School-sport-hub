generator client {
  provider = "prisma-client"
  output   = "../../generated/supabase"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?
  email        String   @unique
  passwordHash String?
  role         String   @default("USER")
  accountType  String   @default("FAN")
  isActive     Boolean  @default(true)
  emailVerifiedAt DateTime?
  emailVerificationRequired Boolean @default(false)
  sessionVersion Int @default(0)
  legacySessionsUntil DateTime?
  mfaSecret String?
  mfaEnabledAt DateTime?
  mfaLastStep Int @default(-1)
  mfaRequiredAfter DateTime?
  authSessions AuthSession[]
  authTokens AuthToken[]
  recoveryCodes RecoveryCode[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fantasyEntries FantasyEntry[]
  items        Item[]
  accessRequests AccessRequest[]
  playerLinks PlayerOwnership[]
  coachLinks CoachAssignment[]
  favorites Favorite[]
  submissions ReviewSubmission[]
  announcements TeamAnnouncement[]
  lineups TeamLineup[]
}

model Item {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Club {
  id            Int           @id @default(autoincrement())
  name          String
  slug          String        @unique
  sport         String
  logoUrl       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  players       Player[]
  homeFixtures  Fixture[]     @relation("HomeClub")
  awayFixtures  Fixture[]     @relation("AwayClub")
  tableEntries  LeagueTable[]
  coaches CoachAssignment[]
  announcements TeamAnnouncement[]
  lineups TeamLineup[]

  @@unique([sport, name])
  @@index([sport])
}

model Player {
  id           Int      @id @default(autoincrement())
  name         String
  fullName     String?
  captain      Boolean  @default(false)
  sport        String
  position     String?
  jerseyNumber Int?
  photoUrl     String?
  price        Float?
  rating       Float?
  matches      Int      @default(0)
  minutes      Int      @default(0)
  goals        Int      @default(0)
  assists      Int      @default(0)
  aces         Int      @default(0)
  blocks       Int      @default(0)
  points       Int      @default(0)
  rebounds     Int      @default(0)
  steals       Int      @default(0)
  turnovers    Int      @default(0)
  fouls        Int      @default(0)
  fieldGoalsMade Int    @default(0)
  threePointersMade Int @default(0)
  freeThrowsMade Int    @default(0)
  kills        Int      @default(0)
  digs         Int      @default(0)
  receives     Int      @default(0)
  setsPlayed   Int      @default(0)
  serveErrors  Int      @default(0)
  cleanSheets  Int      @default(0)
  saves        Int      @default(0)
  yellowCards  Int      @default(0)
  redCards     Int      @default(0)
  clubId       Int?
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sport])
  @@index([clubId])
  ownership PlayerOwnership?
  availability MatchAvailability[]
  snapshots PlayerSnapshot[]
}

model Fixture {
  id          Int       @id @default(autoincrement())
  sport       String
  startsAt    DateTime
  venue       String?
  status      String    @default("SCHEDULED")
  homeClubId  Int?
  awayClubId  Int?
  homeClub    Club?     @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: SetNull)
  awayClub    Club?     @relation("AwayClub", fields: [awayClubId], references: [id], onDelete: SetNull)
  result      Result?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sport, startsAt])
  availability MatchAvailability[]
  lineups TeamLineup[]
}

model AccessRequest {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  targetId Int
  message String
  status String @default("PENDING")
  reviewNote String @default("")
  reviewerId Int?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, kind, targetId])
  @@index([status])
}

model PlayerOwnership {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId Int @unique
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  bio String @default("")
  createdAt DateTime @default(now())
  @@index([userId])
}

model CoachAssignment {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId Int
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, clubId])
}

model Favorite {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  targetId Int
  createdAt DateTime @default(now())
  @@unique([userId, kind, targetId])
}

model ReviewSubmission {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  playerId Int?
  clubId Int?
  fixtureId Int?
  details String
  status String @default("PENDING")
  reviewNote String @default("")
  reviewerId Int?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status])
}

model TeamAnnouncement {
  id Int @id @default(autoincrement())
  clubId Int
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  authorId Int
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title String
  body String
  createdAt DateTime @default(now())
  @@index([clubId, createdAt])
}

model MatchAvailability {
  id Int @id @default(autoincrement())
  playerId Int
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fixtureId Int
  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  status String
  note String @default("")
  updatedAt DateTime @updatedAt
  @@unique([playerId, fixtureId])
}

model TeamLineup {
  id Int @id @default(autoincrement())
  clubId Int
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fixtureId Int
  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  authorId Int
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  playerIds String
  note String @default("")
  updatedAt DateTime @updatedAt
  @@unique([clubId, fixtureId])
}

model PlayerSnapshot {
  id Int @id @default(autoincrement())
  playerId Int
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  stats String
  capturedAt DateTime @default(now())
  @@index([playerId, capturedAt])
}

model Result {
  id        Int      @id @default(autoincrement())
  fixtureId Int      @unique
  homeScore Int
  awayScore Int
  playedAt  DateTime?
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeagueTable {
  id        Int      @id @default(autoincrement())
  sport     String
  clubId    Int
  played    Int      @default(0)
  won       Int      @default(0)
  drawn     Int      @default(0)
  lost      Int      @default(0)
  points    Int      @default(0)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sport, clubId])
  @@index([sport, points])
}

model NewsArticle {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model HomepageContent {
  id        Int      @id @default(1)
  content   String
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id String @id
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version Int
  mfaVerified Boolean @default(false)
  legacyTokenHash String? @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model AuthToken {
  hash String @id
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  payload String?
  version Int
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose])
}
model RecoveryCode {
  hash String @id
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt DateTime?
  @@index([userId])
}
model AuthLimit {
  key String @id
  count Int @default(0)
  resetsAt DateTime
}
model SecurityEvent {
  id Int @id @default(autoincrement())
  userId Int?
  event String
  ipHash String
  resource String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId, createdAt])
}

model FantasyRound {
  id Int @id @default(autoincrement())
  name String
  sport String
  deadline DateTime
  budget Int @default(100)
  status String @default("OPEN")
  rules String
  catalog String
  fixtureIds String
  publishedAt DateTime?
  updatedAt DateTime @updatedAt
  entries FantasyEntry[]
  stats FantasyMatchStat[]
}
model FantasyEntry {
  id Int @id @default(autoincrement())
  roundId Int
  round FantasyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  squad String
  starters String
  captainId Int
  total Int @default(0)
  breakdown String @default("[]")
  updatedAt DateTime @updatedAt
  @@unique([roundId, userId])
}
model InternationalNews {
  id Int @id @default(autoincrement())
  sport String
  linkHash String
  title String
  url String
  source String
  publishedAt DateTime
  @@unique([sport, linkHash])
  @@index([sport, publishedAt, id])
}
model NewsRefresh {
  id String @id
  nextAt DateTime
  fetchedAt DateTime?
}
model FantasyMatchStat {
  id Int @id @default(autoincrement())
  roundId Int
  round FantasyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  fixtureId Int
  playerId Int
  stats String
  updatedAt DateTime @updatedAt
  @@unique([roundId, fixtureId, playerId])
}
